{
  "name": "@finlens/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./finance-queries": {
      "types": "./src/finance-queries.ts",
      "import": "./dist/finance-queries.js"
    },
