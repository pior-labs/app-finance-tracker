# API
API_PORT=3000
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated list, e.g. http://localhost:5173,http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=

# Data paths (relative to api/ when running scripts, /app in Docker)
DATABASE_URL=../data/finlens.db
UPLOAD_DIR=../data/uploads

# Seed users
SEED_USER_1_NAME=Alex
SEED_USER_1_EMAIL=alex@example.com
SEED_USER_1_PASSWORD=change-me-1

SEED_USER_2_NAME=Jamie
SEED_USER_2_EMAIL=jamie@example.com
SEED_USER_2_PASSWORD=change-me-2

# Web
WEB_PORT=5173
VITE_API_BASE_URL=/api
