# Finance API (local development)
# service-auth uses :3000 locally, so Finance defaults to :3001.
API_PORT=3001
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated browser origins allowed to call Finance auth endpoints.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Central Pior Labs Auth (OAuth/OIDC)
# Production uses https://auth.szarans.ca as the canonical Auth hostname.
CENTRAL_AUTH_DISCOVERY_URL=http://localhost:3000/.well-known/openid-configuration
CENTRAL_AUTH_ISSUER=http://localhost:3000
CENTRAL_AUTH_CLIENT_ID=finlens
CENTRAL_AUTH_CLIENT_SECRET=replace-with-the-finlens-oauth-client-secret

# Database + data paths
# Local development expects a Postgres database on this machine.
DATABASE_URL=postgresql://finlens:finlens@localhost:5432/finlens_dev
# Relative paths are resolved from packages/api.
UPLOAD_DIR=../../data/uploads

# Seed users
SEED_USER_1_NAME=Alex
SEED_USER_1_EMAIL=alex@example.com
SEED_USER_1_PASSWORD=change-me-1

SEED_USER_2_NAME=Jamie
SEED_USER_2_EMAIL=jamie@example.com
SEED_USER_2_PASSWORD=change-me-2

# Finance web (local development)
WEB_PORT=5174
VITE_API_BASE_URL=/api
